{
  "license": "MIT",
  "name": "hivemind",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm e2e:real",
    "e2e:fast": "node packages/e2e/src/run.mjs --fast",
    "e2e:full": "node packages/e2e/src/run.mjs --full",
    "e2e:real": "node packages/e2e/src/run.mjs --real",
    "prepare": "npm --prefix packages/cli run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0"
  },
  "bin": {
    "gohive": "packages/cli/dist/bin.js"
  },
  "files": [
    "packages/cli/dist",
    "packages/cli/assets",
    "packages/cli/src",
    "packages/cli/scripts",
    "packages/cli/package.json",
    "packages/cli/tsconfig.json",
    "skills/hive"
  ]
}
