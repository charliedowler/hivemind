# Hive web app. Copy to apps/web/.env.local for local development.
# On Vercel, set the same names in Project Settings > Environment Variables.
# See docs/self-hosting.md for where to get each value.

# --- Required ---
# Postgres 16+ with pgvector. This default matches the docker command in the README.
DATABASE_URL=postgres://hivemind:hivemind@127.0.0.1:54329/hivemind
# Public origin of this deployment, no path. Used for links, OAuth, MCP and install snippets.
PUBLIC_URL=http://localhost:3000
# Better Auth: a long random secret (openssl rand -base64 32) and the auth origin.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Embeddings for search (OpenAI) and answers/classification (Claude).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Bearer secret Vercel Cron sends to the cron routes (apps/web/vercel.json).
CRON_SECRET=

# --- Operator identity shown on legal pages and footers (recommended for public deployments) ---
# Legal name of whoever runs this deployment, e.g. "Example Ltd". Unset: neutral wording.
OPERATOR_NAME=
# Contact address for privacy and terms questions.
OPERATOR_EMAIL=

# --- Optional ---
# Judgement model key (classification, conflicts, Slack gate). Unset: deterministic fallbacks.
TYPESAFE_API_KEY=
# Email codes and invites (Resend). Verify the sending domain first.
RESEND_API_KEY=
EMAIL_FROM=
# Vercel Blob (private store) token for hive exports and conflict decision payloads.
BLOB_READ_WRITE_TOKEN=
# Cookie consent backend (c15t hosted by Inth). Create a project and copy its backend URL.
NEXT_PUBLIC_C15T_BACKEND_URL=
# Analytics traffic label for this deployment: "real" or "synthetic".
HIVE_ANALYTICS_TRAFFIC=
# Private read-only reporting login (docs/analytics.md). Not read by the app.
HIVE_REPORTING_DATABASE_URL=

# Sign-in providers. Each button hides until its credentials are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Hive in Slack (create the app from docs/slack-manifest.json).
SLACK_SIGNING_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored bot tokens.
SLACK_TOKEN_ENCRYPTION_KEY=
# Your Slack app's ID (A...). When set, events for other apps are ignored.
SLACK_APP_ID=
